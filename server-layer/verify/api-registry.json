{
  "_comment": "Role-wise API design + health registry for the MifosSave companion. Single source of truth consumed by api-health.sh. Each endpoint declares the roles whose screens consume it, the access model, a latency SLO class, and a probe type. NEVER execute a write during health checks — writes are wired-check only (GET the path, assert non-404). Regenerate the human view: bash api-health.sh --design.",
  "version": 1,
  "slo_seconds": { "fast": 3.0, "medium": 9.0, "slow": 16.0 },
  "role_groups": {
    "all": ["member", "treasurer", "organizer", "fieldoff"],
    "leadership": ["treasurer", "organizer"],
    "fieldoff": ["fieldoff"]
  },
  "personas": {
    "member":    { "name": "Grace Wanjiru",  "phone": "+254700000003", "password": "DemoMember@2026",  "expect_role": "MEMBER" },
    "treasurer": { "name": "Amina Otieno",   "phone": "+254700000001", "password": "DemoExplore@2026", "expect_role": "TREASURER" },
    "organizer": { "name": "Joseph Mwangi",  "phone": "+254700000002", "password": "DemoChair@2026",   "expect_role": "ORGANIZER" },
    "fieldoff":  { "name": "David Ochieng",  "phone": "+254700000010", "password": "DemoField@2026",   "expect_role": "MEMBER" }
  },
  "endpoints": [
    { "id": "auth-me",              "method": "GET", "path": "/companion/auth/me",                              "access": "companion-service", "screen": "app-launch",        "roles": "all",        "slo": "medium", "probe": "safe" },
    { "id": "groups-mine",          "method": "GET", "path": "/companion/groups/mine",                          "access": "companion-service", "screen": "group-list",        "roles": "all",        "slo": "medium", "probe": "safe" },
    { "id": "member-dashboard",     "method": "GET", "path": "/companion/member/dashboard?groupId={groupId}",   "access": "companion-service", "screen": "personal-dashboard","roles": "all",        "slo": "medium", "probe": "safe" },
    { "id": "organizer-dashboard",  "method": "GET", "path": "/companion/organizer/dashboard",                 "access": "companion-service", "screen": "organizer-dashboard","roles": "leadership","slo": "slow",   "probe": "safe" },

    { "id": "group-detail",         "method": "GET", "path": "/companion/groups/{groupId}",                     "access": "companion-service", "screen": "group-detail",      "roles": "all",        "slo": "medium", "probe": "safe" },
    { "id": "group-my-role",        "method": "GET", "path": "/companion/groups/{groupId}/my-role",             "access": "companion-service", "screen": "group-detail",      "roles": "all",        "slo": "fast",   "probe": "safe" },
    { "id": "group-members",        "method": "GET", "path": "/companion/groups/{groupId}/members",             "access": "companion-service", "screen": "member-list",       "roles": "all",        "slo": "medium", "probe": "safe" },
    { "id": "group-member-savings", "method": "GET", "path": "/companion/groups/{groupId}/members/{clientId}/savings", "access": "companion-service", "screen": "member-savings", "roles": "all",     "slo": "medium", "probe": "safe" },
    { "id": "group-corpus",         "method": "GET", "path": "/companion/groups/{groupId}/corpus",              "access": "companion-service", "screen": "group-detail",      "roles": "all",        "slo": "medium", "probe": "safe" },
    { "id": "group-accounts",       "method": "GET", "path": "/companion/groups/{groupId}/accounts",            "access": "companion-service", "screen": "group-detail",      "roles": "all",        "slo": "medium", "probe": "safe" },
    { "id": "group-dashboard",      "method": "GET", "path": "/companion/groups/{groupId}/dashboard",           "access": "companion-service", "screen": "group-dashboard",   "roles": "all",        "slo": "medium", "probe": "safe" },
    { "id": "group-savings",        "method": "GET", "path": "/companion/groups/{groupId}/savings",             "access": "companion-service", "screen": "savings-dashboard", "roles": "all",        "slo": "medium", "probe": "safe" },
    { "id": "group-savings-indiv",  "method": "GET", "path": "/companion/groups/{groupId}/savings/individual",  "access": "companion-service", "screen": "savings-dashboard", "roles": "all",        "slo": "medium", "probe": "safe" },
    { "id": "savings-txn",          "method": "GET", "path": "/companion/savings/{savingsId}/transactions",     "access": "companion-service-owned", "screen": "personal-savings", "roles": "all",  "slo": "medium", "probe": "safe" },
    { "id": "shareout-preview",     "method": "GET", "path": "/companion/groups/{groupId}/shareout/preview",    "access": "companion-service", "screen": "share-out",         "roles": "leadership", "slo": "medium", "probe": "safe" },

    { "id": "loan-requests",        "method": "GET", "path": "/companion/groups/{groupId}/loan-requests",       "access": "companion-service", "screen": "loan-approvals",    "roles": "leadership", "slo": "medium", "probe": "safe" },
    { "id": "loanproducts",         "method": "GET", "path": "/loanproducts",                                   "access": "fineract-service",  "screen": "loan-apply",        "roles": "all",        "slo": "fast",   "probe": "safe" },
    { "id": "loan-template",        "method": "GET", "path": "/loans/template?clientId={clientId}",             "access": "fineract-service",  "screen": "loan-apply",        "roles": "all",        "slo": "medium", "probe": "safe" },
    { "id": "group-loans",          "method": "GET", "path": "/groups/{groupId}/loans",                         "access": "fineract-service",  "screen": "loan-list",         "roles": "all",        "slo": "medium", "probe": "safe" },
    { "id": "client-loans",         "method": "GET", "path": "/clients/{clientId}/loans",                       "access": "fineract-service",  "screen": "loan-list",         "roles": "all",        "slo": "medium", "probe": "safe" },
    { "id": "active-loans",         "method": "GET", "path": "/loans?groupId={groupId}",                        "access": "companion-service", "screen": "meeting-conduct",   "roles": "leadership", "slo": "medium", "probe": "safe" },
    { "id": "loan-detail",          "method": "GET", "path": "/loans/{loanId}",                                 "access": "fineract-service",  "screen": "loan-detail",       "roles": "all",        "slo": "fast",   "probe": "safe", "requires": "loanId" },
    { "id": "loan-vote",            "method": "GET", "path": "/datatables/dt_loan_vote/{loanId}",               "access": "fineract-service",  "screen": "loan-approvals",    "roles": "leadership", "slo": "fast",   "probe": "safe", "requires": "loanId" },

    { "id": "dt-group-config",      "method": "GET", "path": "/datatables/dt_group_config/{groupId}",           "access": "fineract-service",  "screen": "group-detail",      "roles": "all",        "slo": "fast",   "probe": "safe" },
    { "id": "dt-group-corpus",      "method": "GET", "path": "/datatables/dt_group_corpus/{groupId}",           "access": "fineract-service",  "screen": "group-detail",      "roles": "all",        "slo": "fast",   "probe": "safe" },
    { "id": "dt-member-role",       "method": "GET", "path": "/datatables/dt_member_role/{clientId}",           "access": "fineract-service",  "screen": "member-profile",    "roles": "all",        "slo": "fast",   "probe": "safe" },
    { "id": "dt-meeting-record",    "method": "GET", "path": "/datatables/dt_meeting_record/{groupId}",         "access": "fineract-service",  "screen": "meeting",           "roles": "leadership", "slo": "fast",   "probe": "safe" },
    { "id": "group-type-config",    "method": "GET", "path": "/companion/datatables/group_type_config/{groupId}","access": "companion-service","screen": "group-detail",      "roles": "all",        "slo": "fast",   "probe": "safe" },
    { "id": "group-type-catalog",   "method": "GET", "path": "/companion/datatables/group_type_config",         "access": "companion-service", "screen": "group-create",      "roles": "leadership", "slo": "fast",   "probe": "safe" },
    { "id": "invitations-list",     "method": "GET", "path": "/companion/datatables/invitations/{groupId}",     "access": "companion-service", "screen": "member-invite",     "roles": "leadership", "slo": "medium", "probe": "safe" },

    { "id": "client-detail",        "method": "GET", "path": "/clients/{clientId}",                             "access": "fineract-service",  "screen": "member-profile",    "roles": "all",        "slo": "fast",   "probe": "safe" },
    { "id": "client-accounts",      "method": "GET", "path": "/clients/{clientId}/accounts",                    "access": "fineract-service",  "screen": "member-profile",    "roles": "all",        "slo": "medium", "probe": "safe" },
    { "id": "group-clients",        "method": "GET", "path": "/groups/{groupId}/clients",                       "access": "companion-service", "screen": "member-list",       "roles": "all",        "slo": "medium", "probe": "safe", "note": "companion aggregates group detail + savings + roster, not a plain client list" },
    { "id": "offices",              "method": "GET", "path": "/offices",                                        "access": "fineract-service",  "screen": "group-create",      "roles": "leadership", "slo": "fast",   "probe": "safe" },
    { "id": "group-detail",        "method": "GET", "path": "/groups/{groupId}",                              "access": "fineract-service",  "screen": "meeting",           "roles": "leadership", "slo": "fast",   "probe": "safe" },

    { "id": "fo-groups",            "method": "GET", "path": "/companion/field-officer/groups",                 "access": "companion-service", "screen": "field-officer",     "roles": "fieldoff",   "slo": "fast",   "probe": "safe" },
    { "id": "fo-report",            "method": "GET", "path": "/companion/field-officer/report?R_staffId={clientId}&output-type=CSV", "access": "companion-service", "screen": "field-officer", "roles": "fieldoff", "slo": "medium", "probe": "safe", "note": "CSV export; needs FieldOfficerGroupReport registered via server-layer/migrations/register-reports (companion translates R_staffId->R_loanOfficerId). Returns empty until groups have staff_id assigned." },

    { "id": "change-password",      "method": "PUT",    "path": "/companion/self/user/updatePassword",              "access": "companion-service", "screen": "change-pin",     "roles": "all",        "slo": "fast", "probe": "write" },
    { "id": "create-group",         "method": "POST",   "path": "/companion/groups",                                "access": "companion-service", "screen": "group-create",   "roles": "leadership", "slo": "medium","probe": "write" },
    { "id": "add-member",           "method": "POST",   "path": "/companion/members",                               "access": "companion-service", "screen": "member-add",     "roles": "leadership", "slo": "medium","probe": "write" },
    { "id": "associate-clients",    "method": "POST",   "path": "/companion/groups/{groupId}/associate-clients",    "access": "companion-service", "screen": "member-add",     "roles": "leadership", "slo": "medium","probe": "write" },
    { "id": "rotation-execute",     "method": "POST",   "path": "/companion/groups/{groupId}/rotation/execute",     "access": "companion-service", "screen": "share-out",      "roles": "leadership", "slo": "medium","probe": "write" },
    { "id": "shareout-execute",     "method": "POST",   "path": "/companion/groups/{groupId}/shareout/execute",     "access": "companion-service", "screen": "share-out",      "roles": "leadership", "slo": "medium","probe": "write" },
    { "id": "loan-disburse",        "method": "POST",   "path": "/companion/loan-applications/{clientId}/disburse", "access": "companion-service", "screen": "loan-approvals", "roles": "leadership", "slo": "medium","probe": "write" },
    { "id": "invitation-create",    "method": "POST",   "path": "/companion/datatables/invitations/{groupId}",      "access": "companion-service", "screen": "member-invite",  "roles": "leadership", "slo": "medium","probe": "write" },
    { "id": "invitation-accept",    "method": "PUT",    "path": "/companion/datatables/invitations/{code}/{rowId}", "access": "companion-service", "screen": "join-with-code", "roles": "all",        "slo": "medium","probe": "write" },
    { "id": "invitation-delete",    "method": "DELETE", "path": "/companion/datatables/invitations/{groupId}/{rowId}","access": "companion-service","screen": "member-invite", "roles": "leadership", "slo": "medium","probe": "write" },
    { "id": "loan-request",         "method": "POST",   "path": "/datatables/dt_loan_request",                      "access": "fineract-service",  "screen": "loan-apply",     "roles": "all",        "slo": "medium","probe": "write" },
    { "id": "meeting-attendance",   "method": "POST",   "path": "/datatables/dt_meeting_attendance",                "access": "fineract-service",  "screen": "meeting-conduct","roles": "leadership", "slo": "medium","probe": "write" },
    { "id": "meeting-record",       "method": "POST",   "path": "/datatables/dt_meeting_record",                    "access": "fineract-service",  "screen": "meeting-conduct","roles": "leadership", "slo": "medium","probe": "write" },
    { "id": "member-role-assign",   "method": "POST",   "path": "/datatables/dt_member_role/{clientId}",            "access": "fineract-service",  "screen": "member-add",     "roles": "leadership", "slo": "medium","probe": "write" },
    { "id": "member-role-update",   "method": "PUT",    "path": "/datatables/dt_member_role/{clientId}",            "access": "fineract-service",  "screen": "member-profile", "roles": "leadership", "slo": "medium","probe": "write" },
    { "id": "corpus-update",        "method": "PUT",    "path": "/datatables/dt_group_corpus/{groupId}",            "access": "fineract-service",  "screen": "meeting-conduct","roles": "leadership", "slo": "medium","probe": "write" },
    { "id": "loan-apply",           "method": "POST",   "path": "/loans",                                           "access": "fineract-service",  "screen": "loan-apply",     "roles": "all",        "slo": "medium","probe": "write" },
    { "id": "loan-transaction",     "method": "POST",   "path": "/loans/{loanId}/transactions",                     "access": "fineract-service",  "screen": "loan-detail",    "roles": "all",        "slo": "medium","probe": "write", "requires": "loanId" },
    { "id": "savings-transaction",  "method": "POST",   "path": "/savingsaccounts/{savingsId}/transactions",        "access": "fineract-service",  "screen": "meeting-conduct","roles": "leadership", "slo": "medium","probe": "write", "requires": "savingsId" },
    { "id": "client-create",        "method": "POST",   "path": "/clients",                                         "access": "fineract-service",  "screen": "member-add",     "roles": "leadership", "slo": "medium","probe": "write" },
    { "id": "client-image",         "method": "POST",   "path": "/clients/{clientId}/images",                       "access": "fineract-service",  "screen": "member-profile", "roles": "all",        "slo": "medium","probe": "write" },
    { "id": "batch-sync",           "method": "POST",   "path": "/fineract-provider/api/v1/batches",                "access": "fineract-service",  "screen": "offline-sync",   "roles": "all",        "slo": "medium","probe": "write" },
    { "id": "meeting-reschedule",   "method": "PUT",    "path": "/groups/{groupId}/calendars/1",                   "access": "fineract-service",  "screen": "meeting",        "roles": "leadership", "slo": "medium","probe": "write" }
  ]
}
